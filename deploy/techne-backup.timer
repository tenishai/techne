# techne-backup.timer — nightly consistent backup of every domain db (techne#742)
#
# Pairs with techne-backup.service. Installation (user units — no root required):
#
#   1. Copy both files to ~/.config/systemd/user/
#   2. Edit ExecStart in the .service to the absolute path of your `techne` binary,
#      and set TECHNE_HOME if your state is not in ~/.techne.
#   3. systemctl --user daemon-reload
#      systemctl --user enable --now techne-backup.timer
#   4. Verify:  systemctl --user list-timers techne-backup
#
# --keep IS NOT OPTIONAL ON A TIMER. `techne backup` writes a full set every run and
# nothing prunes by default, so a nightly job without it fills the disk. 14 is the
# value the author's own snapshot tooling settled on.

[Unit]
Description=Nightly techne backup
Documentation=https://github.com/tenishai/techne/blob/main/docs/deployment.md

[Timer]
OnCalendar=daily
# Spread the wake-up so a fleet does not stampede, and catch up after downtime
# rather than silently skipping a night.
RandomizedDelaySec=30m
Persistent=true

[Install]
WantedBy=timers.target
